# ============================================================
# CampusNav Backend — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# Application
APP_NAME=campusnav-backend
ENVIRONMENT=development
DEBUG=true

# ---------------------------------------------------------------
# Supabase PostgreSQL Connection String
# Find under: Supabase Dashboard → Project Settings → Database
#   → Connection string → URI  (use the "Session mode" port 5432)
# Format: postgresql+psycopg2://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------
# Supabase Project Credentials
# Find under: Supabase Dashboard → Project Settings → API
# ---------------------------------------------------------------
SUPABASE_URL=https://nfruowwhjjzrvnsyasle.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# WARNING: Service Role key has full DB access. NEVER expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---------------------------------------------------------------
# JWT Settings
# Use a long random string for SECRET_KEY in production.
# ---------------------------------------------------------------
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins
# ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
